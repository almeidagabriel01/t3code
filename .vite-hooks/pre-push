# knip reads the whole repo (about 2 min on a loaded Mac), so it guards main instead of every commit.
grep -q ' refs/heads/main ' || exit 0
# knip reads the working tree, untracked files included, so it vouches only for a clean one.
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: knip checks the working tree; commit or stash local changes first." >&2
  exit 1
fi
# remoto does not put node_modules/.bin on PATH, so a bare vp exits 127 there.
if command -v remoto >/dev/null 2>&1; then remoto pnpm run knip:check; else vp run knip:check; fi
